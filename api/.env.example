DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_insights?schema=public"
OPENSEARCH_URL="http://localhost:9200"
PORT=3001
# Origin allowed to call this API from a browser (web/'s dev/served origin).
CORS_ORIGIN="http://localhost:3000"
# Pepper for hashing candidate emails (docs/DATA_MODEL.md: never store raw
# email). Generate a real secret per environment — this is a dev-only value.
EMAIL_HASH_SECRET="dev-only-change-me"
# Single shared admin credential for the moderation admin surface (GitHub
# issue #159, Phase 18) — deliberately not a user table, see
# docs/ROADMAP.md Phase 18's scope note. This hash is bcrypt("dev-only-admin-password")
# — a dev-only value, generate a real one per environment. Single-quoted,
# not double-quoted like the vars above: a bcrypt hash always contains `$`,
# which a shell expands as a positional parameter inside double quotes if
# this file is ever `source`d directly.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH='$2b$10$5d3GXDikXoI./2wvbNoUIeG2/aoU72AKnueOEYLMYOxoeL8vD5dlG'
ADMIN_JWT_SECRET="dev-only-change-me-too"
# Whether the admin_session cookie gets the Secure attribute. Must be
# "true" only once this environment is actually served over HTTPS — a
# Secure cookie is silently refused by every browser over plain HTTP.
# Defaults to unset/false, matching every environment this project runs
# in today (local dev, kind — all plain HTTP, no TLS termination yet).
COOKIE_SECURE="false"
# Mailpit (local SMTP catcher, GitHub issue #144, Phase 16 — see
# docs/DECISIONS.md D29 for why not LocalStack SES). Defaults already
# match `kubectl port-forward svc/mailpit 1025:1025 8025:8025` — see
# README.md's Quick start.
MAIL_SMTP_HOST="localhost"
MAIL_SMTP_PORT=1025
MAIL_FROM_ADDRESS="noreply@interview-insights.local"
