DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_insights?schema=public"
OPENSEARCH_URL="http://localhost:9200"
PORT=3001
# Origin allowed to call this API from a browser (web/'s dev/served origin).
CORS_ORIGIN="http://localhost:3000"
# Pepper for hashing candidate emails (docs/DATA_MODEL.md: never store raw
# email). Generate a real secret per environment — this is a dev-only value.
EMAIL_HASH_SECRET="dev-only-change-me"
# Single shared admin credential for the moderation admin surface (GitHub
# issue #159, Phase 18) — deliberately not a user table, see
# docs/ROADMAP.md Phase 18's scope note. This hash is bcrypt("dev-only-admin-password")
# — a dev-only value, generate a real one per environment. Single-quoted,
# not double-quoted like the vars above: a bcrypt hash always contains `$`,
# which a shell expands as a positional parameter inside double quotes if
# this file is ever `source`d directly.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH='$2b$10$5d3GXDikXoI./2wvbNoUIeG2/aoU72AKnueOEYLMYOxoeL8vD5dlG'
ADMIN_JWT_SECRET="dev-only-change-me-too"
# Whether the admin_session cookie gets the Secure attribute. Must be
# "true" only once this environment is actually served over HTTPS — a
# Secure cookie is silently refused by every browser over plain HTTP.
# Defaults to unset/false, matching every environment this project runs
# in today (local dev, kind — all plain HTTP, no TLS termination yet).
COOKIE_SECURE="false"
# Shared parent domain for the admin_session/candidate_session/
# candidate_logged_in cookies, e.g. ".interview-insights.local". Defaults
# to unset (host-only cookie) — correct for local dev, where web/api both
# run on "localhost" and browsers scope cookies by host, ignoring port.
# Every deployed environment serves web/api from genuinely different
# hostnames (app.* vs api.*), so a host-only cookie set by api's response
# is invisible to web's own JS — set this to the shared parent domain in
# any such environment (see infra/k8s's per-overlay ConfigMap patches).
COOKIE_DOMAIN=""
# Mailpit (local SMTP catcher, GitHub issue #144, Phase 16 — see
# docs/DECISIONS.md D29 for why not LocalStack SES). Defaults already
# match `kubectl port-forward svc/mailpit 1025:1025 8025:8025` — see
# README.md's Quick start.
MAIL_SMTP_HOST="localhost"
MAIL_SMTP_PORT=1025
MAIL_FROM_ADDRESS="noreply@interview-insights.local"
# Candidate magic-link session signing secret (GitHub issue #145, Phase
# 16) — deliberately distinct from ADMIN_JWT_SECRET so compromising one
# session type can't forge the other. A dev-only value — generate a real
# one per environment, same as ADMIN_JWT_SECRET.
CANDIDATE_JWT_SECRET="dev-only-change-me-candidate"
# Advisory-only LLM moderation triage (GitHub issue #163, Phase 19) via
# Claude API. Provisioned imperatively like ADMIN_PASSWORD_HASH/
# ADMIN_JWT_SECRET — deliberately no dev-only placeholder value here,
# since there's no equivalent of a bcrypt hash you can fake locally.
# Leave ANTHROPIC_API_KEY empty/unset to keep the feature disabled (every
# write still succeeds; moderationVerdict just stays null). Set both to
# enable it locally.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
# Single hard confidence cutoff for auto-approval routing (D71, GitHub
# issue #439). No dev-default committed here on purpose — tune empirically
# once real verdict/confidence data exists in an environment. Leave unset
# to keep every verdict advisory-only (today's D66 behavior); must be a
# number in [0, 1] when set.
AI_MODERATION_AUTO_APPROVE_THRESHOLD=""
