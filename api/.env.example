DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_insights?schema=public"
PORT=3001
# Origin allowed to call this API from a browser (web/'s dev/served origin).
CORS_ORIGIN="http://localhost:3000"
# Pepper for hashing candidate emails (docs/DATA_MODEL.md: never store raw
# email). Generate a real secret per environment — this is a dev-only value.
EMAIL_HASH_SECRET="dev-only-change-me"
