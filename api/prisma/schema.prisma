// Prisma schema — source of truth is docs/DATA_MODEL.md.
// Do not hand-edit production schema; every change here becomes a migration
// (`npx prisma migrate dev --name <change>`), per docs/DECISIONS.md D6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. companies, candidates
// ---------------------------------------------------------------------------

enum CompanySizeBucket {
  startup
  mid
  large
  enterprise
}

model Company {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  slug       String            @unique
  industry   String?
  sizeBucket CompanySizeBucket @map("size_bucket")
  logoUrl    String?           @map("logo_url")
  // Moderation gate (GitHub issue #369, Phase 35) — reuses the existing
  // ModerationStatus enum rather than a new one, mirroring
  // RoundRating/RecruiterRating/OverallReview exactly: the row exists
  // immediately on creation, just hidden from every public read until
  // approved. A rejected request keeps its row (status: rejected) for an
  // audit trail rather than being deleted.
  status     ModerationStatus  @default(pending)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  interviewProcesses   InterviewProcess[]
  interviewers         Interviewer[]
  recruiters           Recruiter[]
  companyLevelMappings CompanyLevelMapping[]

  @@map("companies")
}

enum VerificationStatus {
  unverified
  email_verified
  document_verified
}

model Candidate {
  id                 String             @id @default(uuid()) @db.Uuid
  // Hashed, never store raw email — see docs/DATA_MODEL.md design principle 1.
  emailHash          String             @unique @map("email_hash")
  // Reversible (AES-256-GCM, GitHub issue #335, D74) — the one deliberate
  // exception to "never store raw email". notification-service needs an
  // actual address to send to, and nothing else in this system ever
  // retains one past the request that computed emailHash above.
  // Decryptable only with EMAIL_ENCRYPTION_KEY, a secret distinct from
  // EMAIL_HASH_SECRET (an HMAC key, not reversible even in principle) so
  // compromising one doesn't compromise the other. Nullable: rows written
  // before this column existed have no way to backfill a raw email from
  // a hash.
  emailEncrypted     String?            @map("email_encrypted")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // GitHub issue #679 (Phase 48, D104) — candidates were the only actor
  // still on magic-link-only auth; this brings them to parity with
  // admin-auth's password + bcrypt pattern (see AdminAuthService).
  // Nullable: every pre-existing candidate row has never set one, and a
  // magic-link login still works without a password ever being set.
  passwordHash  String?   @map("password_hash")
  passwordSetAt DateTime? @map("password_set_at") @db.Timestamptz
  // Bumped on every password change/reset (and nowhere else) to
  // invalidate every JWT issued before that point — CandidateJwtStrategy
  // checks the token's own tokenVersion claim against this column on
  // every request, same "re-check on every request rather than trust the
  // token's claims" reasoning AdminJwtStrategy already uses for
  // isActive/role (D99).
  tokenVersion  Int       @default(0) @map("token_version")

  interviewProcesses InterviewProcess[]
  roundRatings       RoundRating[]
  recruiterRatings   RecruiterRating[]
  overallReviews     OverallReview[]
  verificationTokens CandidateVerificationToken[]
  passwordResetTokens CandidatePasswordResetToken[]

  @@map("candidates")
}

// docs/ROADMAP.md Phase 3 issue #3 — email-verification link/token flow.
// Hashed, never store the raw token — same pattern as candidates.email_hash.
model CandidateVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @map("candidate_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  // Single-use: set the first time this token is successfully verified, or
  // when superseded by a newer token issued for the same candidate.
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@map("candidate_verification_tokens")
}

// GitHub issue #682 (Phase 48, D104) — forgot-password flow. Same shape
// and reasoning as CandidateVerificationToken above (hashed, single-use,
// short-lived) — a separate table rather than reusing
// CandidateVerificationToken because the two token types must never be
// interchangeable (a leaked/guessed magic-link token must not be usable
// to reset a password, and vice versa).
model CandidatePasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @map("candidate_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  // Single-use: set the first time this token is successfully consumed,
  // or when superseded by a newer request for the same candidate.
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@map("candidate_password_reset_tokens")
}

// ---------------------------------------------------------------------------
// 2. interview_processes
// ---------------------------------------------------------------------------

enum ProcessOutcome {
  offer
  rejected
  withdrawn
  ghosted
  in_progress
}

// Phase 2 taxonomy (docs/DATA_MODEL.md D5) — schema-ready, unused until the
// company_level_mappings backfill job exists. `unmapped` is a valid value;
// never guess a mapping.
enum NormalizedBand {
  entry
  mid
  senior
  staff
  principal
  manager
  director
  exec
  unmapped
}

model InterviewProcess {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  candidateId     String          @map("candidate_id") @db.Uuid
  roleTitle       String          @map("role_title")
  // Free text for MVP, e.g. "L5", "Senior" — normalize later, see normalizedBand.
  level           String?
  department      String?
  applicationDate DateTime?       @map("application_date") @db.Date
  outcome         ProcessOutcome
  // Nullable, populated progressively via batch backfill — never inline at write time.
  normalizedBand  NormalizedBand? @map("normalized_band")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  company               Company                @relation(fields: [companyId], references: [id])
  candidate             Candidate              @relation(fields: [candidateId], references: [id])
  rounds                Round[]
  recruiterInteractions RecruiterInteraction[]
  overallReview         OverallReview?

  @@index([companyId, roleTitle])
  @@index([companyId, createdAt])
  @@index([normalizedBand])
  @@map("interview_processes")
}

// ---------------------------------------------------------------------------
// 3. interviewers, recruiters
// ---------------------------------------------------------------------------

model Interviewer {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  // For de-duplication only — never returned by the public API.
  internalIdentifierHash String   @map("internal_identifier_hash")
  // Generated label, e.g. "Interviewer A" — computed per-process, never a real name.
  // See docs/DECISIONS.md D2: hard constraint, do not expose real names publicly.
  displayLabel           String   @map("display_label")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])
  rounds  Round[]

  @@map("interviewers")
}

model Recruiter {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  internalIdentifierHash String   @map("internal_identifier_hash")
  displayLabel           String   @map("display_label")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  company               Company                @relation(fields: [companyId], references: [id])
  recruiterInteractions RecruiterInteraction[]

  // Lets recruiter identity resolution be a safe upsert (same pattern as
  // Candidate.emailHash) instead of a racy find-then-create.
  @@unique([companyId, internalIdentifierHash])
  @@map("recruiters")
}

// ---------------------------------------------------------------------------
// 4. rounds
// ---------------------------------------------------------------------------

enum RoundType {
  coding
  system_design
  behavioral
  leadership
  case_study
  assessment
  take_home
  tech_screening
  other
}

model Round {
  id                       String    @id @default(uuid()) @db.Uuid
  processId                String    @map("process_id") @db.Uuid
  sequenceNumber           Int       @map("sequence_number") @db.SmallInt
  title                    String?
  description              String?
  roundType                RoundType @map("round_type")
  interviewerId            String?   @map("interviewer_id") @db.Uuid
  scheduledDurationMinutes Int?      @map("scheduled_duration_minutes") @db.SmallInt
  // Type-specific fields keyed by roundType — do NOT add new columns per
  // round type, see docs/DATA_MODEL.md "type_metadata examples" and
  // CLAUDE.md conventions.
  typeMetadata             Json?     @map("type_metadata")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz

  process     InterviewProcess @relation(fields: [processId], references: [id])
  interviewer Interviewer?     @relation(fields: [interviewerId], references: [id])
  ratings     RoundRating[]

  @@index([processId, sequenceNumber])
  @@index([roundType])
  @@map("rounds")
}

// ---------------------------------------------------------------------------
// 5. round_ratings
// ---------------------------------------------------------------------------

enum ModerationStatus {
  pending
  approved
  rejected
  flagged
  // GitHub issue #690 (Phase 49, D104) — set instead of the normal
  // 'rejected' when an admin rejects an already-escalated entry (#689:
  // only an admin can, past the lifetime resubmission cap). Terminal:
  // RoundRatingsService.update() and its recruiter_rating/overall_review
  // counterparts refuse any further edit once an entity reaches this
  // status, closing the resubmission loop for good rather than letting
  // it cycle indefinitely.
  permanently_rejected
}

model RoundRating {
  id             String           @id @default(uuid()) @db.Uuid
  roundId        String           @map("round_id") @db.Uuid
  candidateId    String           @map("candidate_id") @db.Uuid
  // difficulty is a property of the round/problem, not the interviewer — a
  // different axis from the three interviewer traits below (GitHub issue #247).
  difficulty     Int              @db.SmallInt
  // Interviewer traits, deliberately limited to three (GitHub issue #247,
  // docs/DECISIONS.md). fairness/biasSignal were dropped — see D45.
  fluency        Int              @db.SmallInt
  clarity        Int              @db.SmallInt
  focus          Int              @db.SmallInt
  technicalDepth Int?             @map("technical_depth") @db.SmallInt
  freeText       String?          @map("free_text")
  status         ModerationStatus @default(pending)
  // Advisory-only LLM triage output (GitHub issue #163, Phase 19) —
  // nullable, same JSONB-column precedent as Round.typeMetadata. Never
  // written synchronously by the write path itself failing this write;
  // computed best-effort after commit by AiModerationService. Null
  // whenever the feature is disabled (no ANTHROPIC_API_KEY configured) or
  // the LLM call/parse failed. Since GitHub issue #439 (D71) this also
  // carries a `confidence` score and a derived `autoApprovalEligible`
  // boolean, but this column is still never itself the thing that acts on
  // that eligibility (CLAUDE.md hard constraint #2) — the system-attributed
  // ModerationService.approve() call that reads it lands in a follow-up
  // issue (#440).
  moderationVerdict Json?          @map("moderation_verdict")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  round     Round     @relation(fields: [roundId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  // One rating per candidate per round — docs/DECISIONS.md D8.
  // 1-5 CHECK constraints (difficulty, fluency, clarity, focus,
  // technical_depth) aren't expressible in Prisma schema language — they're
  // added via raw SQL, see prisma/migrations/*_init/migration.sql and the
  // GitHub issue #247 migration that renamed/dropped/added these.
  @@unique([roundId, candidateId])
  @@map("round_ratings")
}

// ---------------------------------------------------------------------------
// 6. recruiter_interactions
// ---------------------------------------------------------------------------

model RecruiterInteraction {
  id          String   @id @default(uuid()) @db.Uuid
  processId   String   @map("process_id") @db.Uuid
  recruiterId String   @map("recruiter_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  process   InterviewProcess  @relation(fields: [processId], references: [id])
  recruiter Recruiter         @relation(fields: [recruiterId], references: [id])
  ratings   RecruiterRating[]

  @@map("recruiter_interactions")
}

// ---------------------------------------------------------------------------
// 7. recruiter_ratings
// ---------------------------------------------------------------------------

model RecruiterRating {
  id                     String           @id @default(uuid()) @db.Uuid
  recruiterInteractionId String           @map("recruiter_interaction_id") @db.Uuid
  candidateId            String           @map("candidate_id") @db.Uuid
  // reachability: rename+reinterpretation of the old approachability field
  // (friendliness -> "could you actually get hold of them when needed").
  reachability           Int              @db.SmallInt
  // responsiveness: merges the old response_time + timeliness fields — a
  // candidate can't cleanly separate "replied fast" from "kept to promised
  // dates" in one rating anyway (GitHub issue #249, docs/DECISIONS.md D48).
  responsiveness         Int              @db.SmallInt
  // guidelines_shared: how much useful interview-prep guidance the
  // recruiter shared. Kept as a 1-5 rating (not boolean) for uniformity
  // with every other column here.
  guidelinesShared       Int              @map("guidelines_shared") @db.SmallInt
  // Nullable by design: only meaningful for a touchpoint tied to the
  // process's rejection communication, self-reported by the candidate's own
  // judgment — no backend gating against InterviewProcess.outcome (D48).
  rejectionMessageAuthenticity Int?       @map("rejection_message_authenticity") @db.SmallInt
  freeText               String?          @map("free_text")
  status                 ModerationStatus @default(pending)
  // See RoundRating.moderationVerdict's comment — same shape/semantics.
  moderationVerdict      Json?            @map("moderation_verdict")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz

  recruiterInteraction RecruiterInteraction @relation(fields: [recruiterInteractionId], references: [id])
  candidate            Candidate            @relation(fields: [candidateId], references: [id])

  // One rating per candidate per interaction — docs/DECISIONS.md D8.
  // 1-5 CHECK constraints added via raw SQL, see note on RoundRating above.
  @@unique([recruiterInteractionId, candidateId])
  @@map("recruiter_ratings")
}

// ---------------------------------------------------------------------------
// 8. overall_reviews
// ---------------------------------------------------------------------------

model OverallReview {
  id                String           @id @default(uuid()) @db.Uuid
  // One overall review per process.
  processId         String           @unique @map("process_id") @db.Uuid
  candidateId       String           @map("candidate_id") @db.Uuid
  overallExperience Int              @map("overall_experience") @db.SmallInt
  wouldRecommend    Boolean          @map("would_recommend")
  reviewText        String?          @map("review_text")
  status            ModerationStatus @default(pending)
  // See RoundRating.moderationVerdict's comment — same shape/semantics.
  moderationVerdict Json?            @map("moderation_verdict")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  process   InterviewProcess @relation(fields: [processId], references: [id])
  candidate Candidate        @relation(fields: [candidateId], references: [id])

  // 1-5 CHECK constraint added via raw SQL, see note on RoundRating above.
  @@map("overall_reviews")
}

// ---------------------------------------------------------------------------
// 8b. moderators — GitHub issue #485, Phase 36
// ---------------------------------------------------------------------------

// Replaces the single shared ADMIN_USERNAME/ADMIN_PASSWORD_HASH credential
// (Phase 18) with a real identity per moderator. Originally just one row
// (env-seeded on boot, see AdminAuthService.onModuleInit) so claim/
// reviewedBy could FK to something real (Phase 36 issues #486/#487).
// GitHub issue #586 (Phase 42, D99) adds the real role hierarchy on top:
// role/isActive/createdById. Deactivate, never delete — same precedent
// claimedById already set by never being cleared once set.
model Moderator {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash")
  email        String
  role         StaffRole @default(moderator)
  isActive     Boolean   @default(true) @map("is_active")
  // Null for the one root ADMIN (imperatively boot-seeded, D99) — every
  // other account is created through admin tools by an existing ADMIN
  // (GitHub issue #589) and always has a creator.
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  createdBy    Moderator?      @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff Moderator[]     @relation("StaffCreatedBy")

  claimedQueueEntries ModerationQueueEntry[]
  auditLogActions     StaffAuditLog[]        @relation("StaffAuditActor")
  auditLogTargeted    StaffAuditLog[]        @relation("StaffAuditTarget")

  @@map("moderators")
}

enum StaffRole {
  staff
  moderator
  admin
}

// ---------------------------------------------------------------------------
// 8c. staff_audit_log — GitHub issue #586 (Phase 42, D99)
// ---------------------------------------------------------------------------
// Durable record of every admin action against a staff account (account
// created, role changed, deactivated/reactivated, password reset) — never
// best-effort, same precedent AiAutoApprovalAudit (D71) below sets for
// system-attributed decisions. actorId/targetId are equal for a
// self-service password change, distinct for everything an ADMIN does to
// another account — no separate "self vs admin-initiated" column needed,
// that distinction is exactly what actorId vs targetId already encodes.
model StaffAuditLog {
  id        String           @id @default(uuid()) @db.Uuid
  actorId   String           @map("actor_id") @db.Uuid
  targetId  String           @map("target_id") @db.Uuid
  action    StaffAuditAction
  // Optional structured detail, e.g. { "oldRole": "staff", "newRole":
  // "moderator" } for a role_changed row. Not relied on for anything the
  // typed columns above already capture.
  detail    Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  actor  Moderator @relation("StaffAuditActor", fields: [actorId], references: [id])
  target Moderator @relation("StaffAuditTarget", fields: [targetId], references: [id])

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("staff_audit_log")
}

enum StaffAuditAction {
  account_created
  role_changed
  deactivated
  reactivated
  password_reset
}

// ---------------------------------------------------------------------------
// 9. moderation_queue
// ---------------------------------------------------------------------------

enum ModerationEntityType {
  round_rating
  recruiter_rating
  overall_review
  // GitHub issue #369, Phase 35 — company creation moves behind moderation.
  company
}

enum ModerationFlagReason {
  spam_pattern
  rate_limit
  duplicate
  manual_report
  // GitHub issue #442 (Phase 39, D71) — the reconciliation sweep's own
  // escalation reason: a pending row past the 24h staleness window whose
  // re-triage attempt still left moderationVerdict null (feature error,
  // refusal, unparseable response, etc.). Distinguishes an AI-triage
  // failure from every other flag reason above, all of which describe
  // something about the submitted content itself.
  ai_triage_stalled
}

// GitHub issue #688 (Phase 49, D104) — a moderator's own stated reason
// for rejecting content, distinct from ModerationFlagReason above (a
// system/pre-write signal, set before a human ever looks at the entry).
// Surfaced back to the candidate (#688's own rejection-feedback scope)
// and, alongside reviewNote below, to the moderator queue UI when a
// resubmission's prior-submission history is shown (#691).
enum ModerationRejectionReason {
  low_quality
  guideline_violation
  identifying_information
  spam_or_promotional
  inaccurate_or_unverifiable
  other
}

model ModerationQueueEntry {
  id          String                @id @default(uuid()) @db.Uuid
  entityType  ModerationEntityType  @map("entity_type")
  // Polymorphic reference (by entityType) to round_ratings / recruiter_ratings
  // / overall_reviews — intentionally not an FK, see docs/DATA_MODEL.md.
  entityId    String                @map("entity_id") @db.Uuid
  flagReason  ModerationFlagReason? @map("flag_reason")
  reviewedBy  String?               @map("reviewed_by")
  reviewedAt  DateTime?             @map("reviewed_at") @db.Timestamptz
  // GitHub issue #688 (Phase 49, D104) — only ever set alongside a
  // 'rejected' decision (ModerationService.review() only writes these
  // when ModerationActionDto carries them, which reject() alone accepts
  // meaningfully — approve()/flag() calls extending this DTO doesn't add
  // reject-only semantics to them). reviewNote is a free-text elaboration
  // a moderator can add to any decision, not gated to rejections the way
  // rejectionReasonCategory is.
  rejectionReasonCategory ModerationRejectionReason? @map("rejection_reason_category")
  reviewNote              String?                    @map("review_note")
  // GitHub issue #689 (Phase 49, D104) — set by ModerationService.reenqueue()
  // when a resubmission crosses the lifetime cap (default 3 prior
  // submissions, see LIFETIME_RESUBMISSION_CAP in moderation.service.ts).
  // Gates approve()/reject() to admin-only via EscalatedEntryGuard, and
  // skips AI auto-approval entirely (VerdictConsumerService) — a
  // repeatedly-rejected item needs a human admin's judgment, not another
  // automated pass. Never cleared once set, same "record what had
  // happened, don't erase history" precedent slaDeadline's own comment
  // already established.
  escalated               Boolean                    @default(false)
  // GitHub issue #486 (Phase 36, D80) — createdAt + a configurable number
  // of hours (default 48, see ModerationSlaService), computed at enqueue/
  // reenqueue time, not a DB-only default: the configurable-hours value
  // lives in app config, which a static column DEFAULT can't read. Always
  // set, even on already-reviewed entries, so a resolved entry still
  // records what its deadline had been.
  slaDeadline DateTime              @map("sla_deadline") @db.Timestamptz
  // Manual-claim assignment (#487 builds the claim/release endpoints on
  // top of these two columns) — a real FK to Moderator, unlike the
  // polymorphic entityType/entityId pair above, since Moderator rows are
  // never deleted the way rating/review entities can be. Nullable: most
  // entries sit unclaimed until a moderator picks them up.
  claimedById String?               @map("claimed_by") @db.Uuid
  claimedAt   DateTime?             @map("claimed_at") @db.Timestamptz
  // GitHub issue #488 (Phase 36, D80) — set the first time
  // SlaBreachDetectionService's sweep publishes a
  // moderation.queue.sla_breach.v1 event for this entry, so a still-
  // breached entry (still unreviewed, past slaDeadline) is never
  // re-notified on every later sweep tick. Never cleared once set, even
  // if the entry is later reviewed — same "record what had happened,
  // don't erase history" precedent slaDeadline's own comment already set.
  breachNotifiedAt DateTime?        @map("breach_notified_at") @db.Timestamptz
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz

  claimedBy Moderator? @relation(fields: [claimedById], references: [id])

  @@index([entityType, entityId])
  @@map("moderation_queue")

  aiAutoApprovalAudits AiAutoApprovalAudit[]
}

// ---------------------------------------------------------------------------
// 9b. ai_auto_approval_audit — GitHub issue #440 (Phase 39, D71)
// ---------------------------------------------------------------------------
// Append-only record of every system-attributed auto-approval decision —
// deliberately a separate table from the mutable per-entity
// moderationVerdict JSONB column (round_ratings/recruiter_ratings/
// overall_reviews above), so this row survives a later human override or
// re-triage of that same JSONB column, which a shared column would not.
// Written atomically with the moderation_queue approval it documents (see
// ModerationService.approveWithAudit) — never inserted separately/
// best-effort the way D16/D17's search indexing is, since a wrong
// auto-approve is real user-facing content published unattended.
model AiAutoApprovalAudit {
  id                     String               @id @default(uuid()) @db.Uuid
  // Same polymorphic (entityType, entityId) pairing moderation_queue uses —
  // intentionally not an FK, see docs/DATA_MODEL.md. Always one of the
  // triageable types (round_rating/recruiter_rating/overall_review); never
  // `company`, which AiModerationService never triages.
  entityType             ModerationEntityType @map("entity_type")
  entityId               String               @map("entity_id") @db.Uuid
  // The moderation_queue row this decision approved — a real FK (unlike the
  // polymorphic pair above), since moderation_queue entries are never
  // deleted once resolved and this is the one place record identity is
  // stable enough to reference directly.
  moderationQueueEntryId String               @map("moderation_queue_entry_id") @db.Uuid
  // The exact content sent to the model and its raw text response, kept
  // verbatim alongside the parsed verdict below — the durable "prompt/
  // response" pairing this issue's scope calls for.
  promptContent          String               @map("prompt_content")
  responseText           String               @map("response_text")
  // Full parsed verdict (concerning/reasons/summary/confidence/model/
  // analyzedAt/autoApprovalEligible) — same shape as moderationVerdict at
  // the moment this decision was made, preserved here even if that column
  // later changes. confidence/model are pulled out as their own columns too
  // (denormalized from verdict) purely so they're queryable without a JSON
  // path expression.
  verdict                Json
  confidence             Float
  model                  String
  // Always "approved" today — auto-approval never auto-rejects (D71) — kept
  // as its own column rather than hardcoded so this table could describe a
  // wider set of system decisions without a schema change if that scope
  // ever grows.
  decision               ModerationStatus     @default(approved)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz

  moderationQueueEntry ModerationQueueEntry @relation(fields: [moderationQueueEntryId], references: [id])

  @@index([entityType, entityId])
  @@map("ai_auto_approval_audit")
}

// ---------------------------------------------------------------------------
// 10. round_type_field_options — Phase 24 issue #248, D47
// ---------------------------------------------------------------------------
// Admin-controlled selectable values for the round-type registry's
// controlled-vocabulary type_metadata fields (see api/src/round-type-registry).
// One row per selectable value, e.g. (coding, problemAlgorithms, "DFS").
// This issue only reads/seeds this table; admin CRUD over it is Phase 27.

model RoundTypeFieldOption {
  id        String    @id @default(uuid()) @db.Uuid
  roundType RoundType @map("round_type")
  fieldKey  String    @map("field_key")
  value     String
  sortOrder Int       @default(0) @map("sort_order")
  // Retiring a value flips this off rather than deleting the row, so
  // historical type_metadata referencing it stays valid — see D47.
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([roundType, fieldKey, value])
  @@index([roundType, fieldKey, isActive])
  @@map("round_type_field_options")
}

// ---------------------------------------------------------------------------
// 11. company_level_mappings — phase 2, schema-ready but unused at MVP (D5)
// ---------------------------------------------------------------------------

model CompanyLevelMapping {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  rawLevelString String         @map("raw_level_string")
  normalizedBand NormalizedBand @map("normalized_band")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, rawLevelString])
  @@map("company_level_mappings")
}

// ---------------------------------------------------------------------------
// 12. Aggregation layer (materialized views) — NOT modeled here.
// ---------------------------------------------------------------------------
// company_round_type_aggregates, company_recruiter_aggregates, and
// company_overall_aggregates (docs/DATA_MODEL.md "Aggregation layer") are
// Postgres materialized views, not Prisma models — Prisma migrations don't
// manage them well. They'll be added as raw SQL in a dedicated migration
// (`prisma migrate dev --create-only` + hand-written CREATE MATERIALIZED VIEW)
// when Phase 4 (analytics) starts. See docs/ROADMAP.md Phase 4.

// ---------------------------------------------------------------------------
// 13. notification_log — Phase 31 (D53), GitHub issue #335
// ---------------------------------------------------------------------------
// Written and read exclusively by notification-service (services/
// notification-service/), never by api — this table's migration still
// lives here because api's migrations are this project's one source of
// truth for schema (CLAUDE.md hard constraint #5), not because api has
// any runtime use for it. entityType/eventType are plain text, not the
// ModerationEntityType enum used elsewhere in this file: notification-
// service generates its own, independent Prisma client against a
// deliberately minimal schema.prisma of its own (see docs/DECISIONS.md
// D75), and a shared Postgres enum type would couple that client's
// generation to an enum definition it doesn't own — same
// duplicate-rather-than-share reasoning D73 already established for the
// SMTP wiring itself.
model NotificationLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  eventType  String   @map("event_type")
  // GitHub issue #687 (Phase 49, D104) — confirmed bug fix: a candidate
  // editing a rejected/flagged entity gets re-enqueued (reenqueue()) into
  // a *fresh* moderation_queue row for the same entityId, but the old key
  // (entityType+entityId+eventType alone) treated any status_changed
  // event on that entityId as "already notified," so a candidate was
  // never notified of any review decision after the first one. Empty
  // string default for event types that don't carry a real one
  // (created/sla_breach — see notification-consumer.service.ts's own
  // moderationQueueEntryIdFor()) so their pre-existing dedup behavior is
  // unchanged; the actual moderation_queue entry id for status_changed
  // events, giving each resubmission's decision its own dedup key.
  moderationQueueEntryId String   @default("") @map("moderation_queue_entry_id")
  sentAt                 DateTime @default(now()) @map("sent_at") @db.Timestamptz

  // The idempotency key itself (issue #335's acceptance criteria): a
  // redelivered event's INSERT hits this constraint and is skipped rather
  // than sending a second email, same "insert first, only act if the
  // insert actually happened" shape as every unique-constraint-as-lock
  // pattern already used elsewhere in this schema (e.g. one rating per
  // candidate per round).
  @@unique([entityType, entityId, eventType, moderationQueueEntryId], name: "notification_log_dedup_key")
  @@map("notification_log")
}
