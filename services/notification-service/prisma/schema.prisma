// GitHub issue #335, docs/DECISIONS.md D75 — a deliberately minimal
// mirror of api/prisma/schema.prisma's Candidate model plus the
// notification_log table this service owns. api's migrations
// (api/prisma/migrations/) are this project's one source of truth for
// the *actual* database schema (CLAUDE.md hard constraint #5) — this
// file exists only to generate a typed Prisma client against tables
// that already exist by the time this service boots. Never run
// `prisma migrate` from here; there is no `prisma/migrations/` directory
// in this package on purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Read-only in practice: only emailEncrypted is ever selected, to
// decrypt a candidate's address for the "pending review" email.
model Candidate {
  id             String  @id @db.Uuid
  emailEncrypted String? @map("email_encrypted")

  @@map("candidates")
}

// GitHub issue #489 (Phase 36) — a deliberately minimal mirror of
// GitHub issue #701 (Phase 51, D104) — mirrors api/prisma/schema.prisma's
// own StaffRole enum, needed by staff.account.created.v1/role_changed.v1's
// TS types (StaffAccountCreatedEventV1/StaffAccountRoleChangedEventV1).
enum StaffRole {
  staff
  moderator
  admin
}

// api/prisma/schema.prisma's Moderator model, same D75 "duplicate a
// read-only subset of an existing table, generate an independent client"
// pattern already used for Candidate above. id/email resolve a
// moderation.queue.sla_breach.v1 event's claimedById to an address.
// GitHub issue #703 (Phase 51, D104) added role/isActive —
// StaffNotificationRecipientsService's own role -> active email list
// query.
model Moderator {
  id       String    @id @db.Uuid
  email    String
  role     StaffRole @default(moderator)
  isActive Boolean   @default(true) @map("is_active")

  @@map("moderators")
}

// See api/prisma/schema.prisma's own NotificationLog model for why
// entityType/eventType are plain text here, not a shared Postgres enum.
model NotificationLog {
  id                     String   @id @default(uuid()) @db.Uuid
  entityType             String   @map("entity_type")
  entityId               String   @map("entity_id") @db.Uuid
  eventType              String   @map("event_type")
  // GitHub issue #687 (Phase 49, D104) — see api/prisma/schema.prisma's
  // own NotificationLog model comment for why.
  moderationQueueEntryId String   @default("") @map("moderation_queue_entry_id")
  sentAt                 DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@unique([entityType, entityId, eventType, moderationQueueEntryId], name: "notification_log_dedup_key")
  @@map("notification_log")
}

// Duplicated from api/prisma/schema.prisma's own ModerationStatus enum
// (GitHub issue #336) — needed to type the `newStatus` field on the
// *.status_changed.v1 event schemas duplicated into events/schemas/.
// This service never writes a ModerationStatus column itself, so this
// exists purely to generate the matching TypeScript type.
enum ModerationStatus {
  pending
  approved
  rejected
  flagged
}

// GitHub issue #711 (Phase 49, D104) — ReconciliationSweepService's read
// needs, same minimal-mirror D75 pattern as Candidate/Moderator above.
// Deliberately narrow: only reviewedAt (to find stale reviewed entries)
// and the polymorphic entityType/entityId reference — no flagReason,
// slaDeadline, or claim fields, since the sweep only cares "was this
// resolved, and is there a notification for it yet."
model ModerationQueueEntry {
  id         String    @id @db.Uuid
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz

  @@map("moderation_queue")
}

// Three more minimal mirrors, same reasoning — only what the sweep needs
// to decide whether a missed decision is notification-worthy
// (status: approved/rejected only, same as notificationFor()'s existing
// no-op for pending/flagged) and who to email.
// createdAt lets the sweep also cover a missed *.created notification
// (D106's documented scope for this sweep), bounded to a two-sided
// window (see reconciliation-sweep.service.ts's own comment) so the
// query never has to scan every row this table has ever held.
model RoundRating {
  id          String           @id @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  status      ModerationStatus
  createdAt   DateTime         @map("created_at") @db.Timestamptz

  @@map("round_ratings")
}

model RecruiterRating {
  id          String           @id @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  status      ModerationStatus
  createdAt   DateTime         @map("created_at") @db.Timestamptz

  @@map("recruiter_ratings")
}

model OverallReview {
  id          String           @id @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  status      ModerationStatus
  createdAt   DateTime         @map("created_at") @db.Timestamptz

  @@map("overall_reviews")
}
