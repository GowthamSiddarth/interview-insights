PORT=3002
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_insights?schema=public"
# Same reversible-decryption key api/'s EMAIL_ENCRYPTION_KEY is set to
# (GitHub issue #335, D74) — must match exactly, or decryptEmail() fails
# every candidate lookup. A 32-byte AES-256 key, hex-encoded (64 hex chars).
EMAIL_ENCRYPTION_KEY="1111111111111111111111111111111111111111111111111111111111111111"
# Redpanda (GitHub issue #330, D53) — comma-separated broker list. Same
# default as api/.env.example: infra/docker-compose.yml's `redpanda`
# service's external listener.
REDPANDA_BROKERS="localhost:19092"
# Mailpit (local SMTP catcher, docs/DECISIONS.md D29) — same defaults as
# api/.env.example.
MAIL_SMTP_HOST="localhost"
MAIL_SMTP_PORT=1025
MAIL_FROM_ADDRESS="noreply@interview-insights.local"
