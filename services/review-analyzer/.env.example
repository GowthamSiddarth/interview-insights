PORT=3003
# Redpanda (GitHub issue #330, D53) — comma-separated broker list. Same
# default as api/.env.example and services/notification-service/.env.example:
# infra/docker-compose.yml's `redpanda` service's external listener.
REDPANDA_BROKERS="localhost:19092"
# GitHub issue #340, D75/D81 — own read-only Prisma schema against the same
# Postgres api/notification-service use.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_insights?schema=public"
# GitHub issue #340, D81 — moved here from api/.env.example: this service is
# now the only place the LLM is ever called from. Leave ANTHROPIC_API_KEY
# empty/unset to keep the feature disabled (a *.created event is received
# and logged, just never triaged). Set both to enable it locally.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
# Single hard confidence cutoff for auto-approval routing (D71, GitHub
# issue #439). No dev-default committed here on purpose — tune empirically
# once real verdict/confidence data exists in an environment. Leave unset
# to keep every verdict advisory-only (today's D66 behavior); must be a
# number in [0, 1] when set.
AI_MODERATION_AUTO_APPROVE_THRESHOLD=""
# Global kill switch for auto-approval (D71, GitHub issue #441). Must be
# exactly "true" to let a clean, high-confidence verdict auto-approve;
# unset or any other value forces every verdict back to D66's original
# advisory-only behavior — no deploy needed to flip it. Separate from
# AI_MODERATION_AUTO_APPROVE_THRESHOLD above so turning this off doesn't
# lose an already-tuned threshold.
AI_AUTO_APPROVAL_ENABLED="false"
